{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lifesort-openhands-control",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-26",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ]
}
